# --- RAG Constructor configuration ---
# Copy to `.env` and adjust. All backends are EXTERNAL instances (ADR-004):
# rag-constructor does not run its own Qdrant/Neo4j/OpenSearch.

# API server
API_HOST=0.0.0.0
API_PORT=8082

# --- Technology registry (STAGE-6 Ф1, ADR-010) ---
# Managed PostgreSQL on render.com. Required for the unified technology registry
# (technologies, evidence, maturity_history, change_queue). On render.com this is
# provided as DATABASE_URL automatically for the managed Postgres instance.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# --- Registry initialization (optional) ---
# Set to 1 to run scripts/seed_db.py on application startup if the registry is
# empty. Leave unset in production (run seed explicitly via CLI).
SEED_DB_ON_STARTUP=

# --- Retrieval backends (axis 2 "store") ---
# Leave unset to use the in-memory stub retriever (MVP). Set to use real backends.
QDRANT_HOST=
QDRANT_PORT=6333
OPENSEARCH_HOST=
OPENSEARCH_PORT=9200
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Embedder (used by retrieval + internal metrics) ---
# Leave unset to use the stub embedder. Set EMBEDDER_HOST+EMBEDDER_MODEL for an
# OpenAI-compatible /v1/embeddings endpoint (LiteLLM proxy, lighter than local).
# Set only EMBEDDER_MODEL for local sentence-transformers (needs pip install ".[embedders]").
EMBEDDER_HOST=
EMBEDDER_PORT=4000
EMBEDDER_MODEL=

# --- Generator: OpenAI-compatible (LiteLLM proxy / vLLM) ---
# Leave unset to use the stub generator. Set for real LLM generation.
LLM_HOST=
LLM_PORT=4000
LLM_MODEL=

# --- Generator (axis 6 "generation") ---
# Leave unset to use the stub generator. Set for a real LLM (Ollama/vLLM).
OLLAMA_HOST=
OLLAMA_MODEL=

# --- Reranker (axis 4 "rerank", real cross-encoder) ---
# Leave unset to use the stub cross-encoder. Set to a model name for a neural reranker.
RERANKER_MODEL=

# --- CORS (dev) ---
CORS_ORIGINS=*
