# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
*.egg-info
dist/
build/
.venv/
venv/

# --- Environment / secrets ---
.env
.env.*
!.env.example
*.log

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# --- Node / frontend ---
node_modules/
ui/dist/
ui/tsconfig.tsbuildinfo

# --- MLflow / experiment tracking ---
mlruns/
mlartifacts/

# --- Model weights (large; keep them in internal storage) ---
*.bin
*.safetensors
*.gguf
models/

# --- Vector stores / search backends local data ---
qdrant_storage/
opensearch-data/
neo4j-data/

# --- IDE ---
.idea/
.vscode/
*.iml

# --- AI assistant session caches (not part of the repository) ---
.zcode/
.deepeval/
# Local, per-machine settings. .claude/launch.json is shared on purpose:
# it names the dev-server commands and belongs to everyone.
.claude/settings.local.json

# --- OS ---
*.DS_Store
Thumbs.db

# --- Eval artifacts with sensitive content ---
eval/golden/private/

# The built artefacts of the portal are versioned deliberately. They derive from
# data/, but they are what the static hosting publishes: the build runs the
# interface build commands and no Python. Without the artefacts in the
# repository, the published portal would be left without data.
# tests/architecture/test_artifacts_in_sync.py guards against drift from data/.
